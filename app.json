{
  "expo": {
    "name": "Domify",
    "slug": "domusrd-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "backgroundColor": "#102E47",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.domusrd.mobile"
    },
    "android": {
      "package": "com.domusrd.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#102E47"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#102E47",
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Domify necesita acceso a tus fotos para que puedas subir imágenes de la propiedad.",
          "cameraPermission": "Domify necesita acceso a la cámara para que puedas fotografiar la propiedad."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Domify necesita tu ubicación para marcar dónde está la propiedad que estás publicando."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#164060"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Domify usa Face ID para desbloquear la app cuando activás el bloqueo con biometría."
        }
      ]
    ]
  }
}
