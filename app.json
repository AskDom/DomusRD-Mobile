{
  "expo": {
    "name": "DomusRD",
    "slug": "domusrd-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "backgroundColor": "#102E47",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.domusrd.mobile"
    },
    "android": {
      "package": "com.domusrd.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#102E47"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#102E47",
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store"
    ]
  }
}
